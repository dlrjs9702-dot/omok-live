{
  "name": "omok-live",
  "version": "1.6.88",
  "private": true,
  "description": "입장 파일 + 공용 방/채팅 + 오목/오델로 기반 실시간 보드게임 서버",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test",
    "test:e2e": "node scripts/run-playwright.js",
    "test:e2e:ui": "node scripts/run-playwright.js --ui",
    "test:e2e:report": "playwright show-report"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
